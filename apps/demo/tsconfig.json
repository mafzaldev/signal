{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The seed script runs directly in Node by stripping types, so only erasable syntax is allowed.
    "erasableSyntaxOnly": true,
    // Imports name the .ts files Node and Vite actually load.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
