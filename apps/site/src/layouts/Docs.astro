---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const SECTIONS = ['Start here', 'Concepts', 'SDKs', 'Reference'] as const;
const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const groups = SECTIONS.map((section) => ({
  section,
  pages: pages.filter((page) => page.data.section === section),
}));
const index = pages.findIndex((page) => page.id === entry.id);
const previous = pages[index - 1];
const next = pages[index + 1];
---

<Base title={`${entry.data.title} · Signal docs`} description={entry.data.description}>
  <div class="container docs">
    <nav class="sidebar" aria-label="Documentation">
      {
        groups.map((group) => (
          <div class="group">
            <p class="group-title">{group.section}</p>
            <ul>
              {group.pages.map((page) => (
                <li>
                  <a
                    href={`/docs/${page.id}`}
                    aria-current={page.id === entry.id ? 'page' : undefined}
                  >
                    {page.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <article class="content">
      <header>
        <p class="section">{entry.data.section}</p>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
      <nav class="pager" aria-label="Previous and next page">
        {
          previous ? (
            <a href={`/docs/${previous.id}`} class="pager-link">
              <span>Previous</span>
              {previous.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/docs/${next.id}`} class="pager-link next">
              <span>Next</span>
              {next.data.title}
            </a>
          )
        }
      </nav>
    </article>
  </div>
</Base>

<style>
  .docs {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    padding-block: 56px 96px;
  }

  /* Beside the article on wide screens; above it, wrapping, on a phone. */
  .sidebar {
    flex: 1 1 200px;
    max-width: 240px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-size: 14px;
    /* Stays in view while the article scrolls; scrolls itself if the window is short. */
    position: sticky;
    top: 24px;
    align-self: flex-start;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
  }

  .group-title {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar a {
    display: block;
    padding: 6px 10px;
    margin-left: -10px;
    border-radius: 6px;
    color: var(--ink-2);
    text-decoration: none;
  }

  .sidebar a:hover {
    background: var(--wash);
    color: var(--ink);
  }

  .sidebar a[aria-current='page'] {
    background: var(--signal-wash);
    color: var(--signal-ink);
    font-weight: 500;
  }

  .content {
    flex: 999 1 560px;
    min-width: 0;
    max-width: 760px;
  }

  .section {
    margin: 0 0 8px;
    font-size: 14px;
    color: var(--signal-ink);
    font-weight: 500;
  }

  h1 {
    margin: 0;
    font-size: clamp(32px, 5vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .lead {
    margin: 14px 0 0;
    font-size: 18px;
    color: var(--ink-2);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    font-weight: 600;
  }

  .pager-link span {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }

  .pager-link:hover {
    color: var(--signal-ink);
  }

  .pager-link.next {
    margin-left: auto;
    text-align: right;
  }

  @media (max-width: 860px) {
    .sidebar {
      position: static;
      max-height: none;
      max-width: none;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 16px 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--rule);
    }
  }

  /* Rendered Markdown. */
  .prose {
    margin-top: 40px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .prose :global(h2) {
    margin: 48px 0 12px;
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(h3) {
    margin: 32px 0 8px;
    font-size: 18px;
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 16px;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }

  .prose :global(a) {
    color: var(--signal-ink);
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(:not(pre) > code) {
    font-size: 0.88em;
    background: var(--wash);
    border-radius: 4px;
    padding: 2px 5px;
    color: var(--ink);
  }

  .prose :global(pre) {
    margin: 0 0 20px;
    padding: 18px 20px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--surface) !important;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.65;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin: 0 0 20px;
    border-collapse: collapse;
    font-size: 14.5px;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule);
  }

  .prose :global(th) {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--rule-strong);
  }

  .prose :global(blockquote) {
    margin: 0 0 20px;
    padding: 12px 18px;
    border-radius: 10px;
    background: var(--signal-wash);
    color: var(--ink);
  }

  .prose :global(blockquote p) {
    margin: 0;
  }
</style>
