{
  "name": "@mafzaldev/signal",
  "version": "0.0.0",
  "description": "TypeScript SDK for Signal feature flags, with live updates and local caching",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@signal/core": "workspace:*",
    "tsup": "^8.5.1"
  }
}
