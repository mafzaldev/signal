{
  "name": "@mafzaldev/signal",
  "version": "1.0.1",
  "description": "TypeScript SDK for Signal, the release control platform: in-process evaluation, live updates and offline caching",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "release-control",
    "rollout",
    "percentage-rollout",
    "targeting",
    "kill-switch",
    "sse",
    "self-hosted",
    "sdk",
    "typescript"
  ],
  "homepage": "https://signal.mafzal.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafzaldev/signal.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@signal/core": "workspace:*",
    "tsup": "^8.5.1"
  }
}
